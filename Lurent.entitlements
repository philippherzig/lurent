<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime resource access: read/write the Photos library via
	     PhotoKit (load templates, save finished wallpapers into an album).

	     Deliberately NOT sandboxed. The App Sandbox itself works — measured on
	     macOS 26, including setting the desktop from inside the container — but a
	     sandboxed build cannot reach `iCloud Drive/Lurent/`, so it would quietly
	     start an empty collection and existing users would find their wallpapers
	     gone. Sandboxing only pays off together with the app's own iCloud
	     container, and that needs a provisioning profile, i.e. the App Store,
	     which Lurent no longer targets. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
