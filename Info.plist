<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Lurent</string>
	<key>CFBundleDisplayName</key>
	<string>Lurent</string>
	<key>CFBundleIdentifier</key>
	<string>app.lurent</string>
	<key>CFBundleExecutable</key>
	<string>Lurent</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.10</string>
	<key>CFBundleVersion</key>
	<string>12</string>
	<!-- German is the development/base language (the string literals in code are
	     the localization keys); the other languages ship as <lang>.lproj bundles. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
		<string>es</string>
		<string>fr</string>
		<string>pt-BR</string>
		<string>it</string>
		<string>ja</string>
		<string>zh-Hans</string>
		<string>ko</string>
		<string>ru</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lurent kann Bilder aus deiner Fotos-Mediathek als Vorlage laden und fertige Wallpaper in einem Album sichern.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Lurent sichert fertige Wallpaper in deiner Fotos-Mediathek.</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<!-- A Lurent project is a *package*: a folder holding project.json, the source
	     photo and the renders, which the Finder shows as one document once this
	     declaration is registered with LaunchServices. Declaring it here is what
	     turns the on-disk layout into something users can move, copy, AirDrop and
	     back up without it falling apart. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.lurent.project</string>
			<key>UTTypeDescription</key>
			<string>Lurent-Projekt</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
				<string>public.composite-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>lurent</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Lurent-Projekt</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.lurent.project</string>
			</array>
		</dict>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>Fotos via Wikimedia Commons und Pexels. Erstellt mit Lurent.</string>
</dict>
</plist>
