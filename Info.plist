	     background check; the app menu also has a manual "Nach Updates suchen…". -->
	<key>SUFeedURL</key>
	<string>https://updates.lurent.app/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>hF36Nb4XK0w+6GAEGIkhTRf6FspFy4GZHv+omimHRu0=</string>
