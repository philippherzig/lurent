# Copy to .env and fill in your secrets. The .env file is gitignored, never committed.

# --- Unsplash ---------------------------------------------------------------
# build.sh reads this and generates build/Secrets.generated.swift at build time.
UNSPLASH_ACCESS_KEY=

# --- Cloudflare R2 (Sparkle update hosting) ---------------------------------
# Used by ./release.sh to upload appcast.xml + the update .zip, and by
# ./Tools/provision-r2.sh to create the bucket. Create ONE "R2 API Token" in the
# Cloudflare dashboard (R2 → Manage R2 API Tokens → Create) — that page shows all
# three values below (Account ID + an S3 Access Key ID + Secret).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: only needed to auto-bind the custom domain updates.lurent.app from
# provision-r2.sh. Leave blank to instead connect the domain with 4 clicks in the
# dashboard (R2 → bucket → Settings → Custom Domains → Connect Domain). The API
# token needs "Workers R2 Storage: Edit" + "Zone → DNS: Edit" for lurent.app.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
