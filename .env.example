# Copy to .env if you deploy the Pexels caching Worker. Gitignored, never committed.
# The app and build.sh read nothing from here: users enter their own API keys in
# Lurent › Settings…, where they are kept in the Keychain.

# Your copy of the key behind pexels.lurent.app, for
# `wrangler secret put PEXELS_ACCESS_KEY` (workers/pexels-cache).
# Free key from https://www.pexels.com/api/ (the default tier needs no approval).
PEXELS_ACCESS_KEY=
